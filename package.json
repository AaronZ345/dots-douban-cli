{
  "name": "douban-cli",
  "version": "0.3.0",
  "description": "豆瓣书影、片单与个人短评管理 CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "douban-cli": "dist/index.js"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prebuild": "npm run clean",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "postbuild": "node scripts/postbuild.mjs",
    "lint": "eslint src scripts eslint.config.js",
    "test": "vitest run",
    "test:cli": "node scripts/smoke-cli.mjs",
    "verify": "npm run lint && npm run typecheck && npm run typecheck:test && npm test && npm run build && npm run test:cli",
    "prepack": "npm run verify",
    "install:browsers": "node scripts/install-browsers.mjs",
    "test:live": "node scripts/live-check.mjs",
    "test:browsers": "node scripts/browser-check.mjs",
    "test:mcp": "node scripts/mcp-check.mjs",
    "install:skill": "node scripts/install-skill.mjs"
  },
  "keywords": [
    "douban",
    "douban-cli",
    "cli",
    "movie",
    "tv",
    "book",
    "豆瓣",
    "电影",
    "影视",
    "top250",
    "rating",
    "search",
    "terminal",
    "command-line"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@steipete/sweet-cookie": "0.4.1",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "playwright": "^1.64.0",
    "undici": "^7.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "@modelcontextprotocol/client": "^2.3.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "scripts/install-browsers.mjs",
    "scripts/live-check.mjs",
    "skills",
    "docs",
    "CHANGELOG.md",
    "scripts/install-skill.mjs",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/AaronZ345/douban-cli.git"
  },
  "homepage": "https://github.com/AaronZ345/douban-cli#readme",
  "bugs": {
    "url": "https://github.com/AaronZ345/douban-cli/issues"
  }
}
