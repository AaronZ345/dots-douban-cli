{
  "name": "@marvae24/douban-cli",
  "version": "0.3.0",
  "description": "Douban CLI - browse movies, TV shows, books, reviews, and collections from the terminal | 豆瓣命令行工具",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "douban": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "postbuild": "node scripts/postbuild.mjs",
    "lint": "eslint src scripts eslint.config.js",
    "test": "vitest run",
    "test:cli": "node scripts/smoke-cli.mjs",
    "verify": "npm run lint && npm run typecheck && npm run typecheck:test && npm test && npm run build && npm run test:cli",
    "prepack": "npm run verify"
  },
  "keywords": [
    "douban",
    "douban-cli",
    "cli",
    "movie",
    "tv",
    "book",
    "豆瓣",
    "电影",
    "影视",
    "top250",
    "rating",
    "search",
    "terminal",
    "command-line"
  ],
  "author": "Marvae",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Marvae/douban-cli.git"
  },
  "homepage": "https://github.com/Marvae/douban-cli",
  "dependencies": {
    "@steipete/sweet-cookie": "0.4.1",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  }
}
